# MURU ConjectureLab v1 — .gitignore
#
# Principle: ignore anything that is (a) re-downloadable from a pinned source,
# (b) regenerable by running the pipeline, or (c) a secret. Everything that
# records WHAT WAS DONE — source, config, manifests, reports, tests — is tracked.
#
# Explicitly NOT ignored (do not add these):
#   MURU_ConjectureLab_v1_Master_Plan.md   controlling specification
#   MURU_Reference_Pack/                   reference documentation + PDFs
#   src/, tests/, configs/                 source, tests, configuration
#   docs/, *.md reports                    scientific reports
#   **/MANIFEST.json, **/*SHA256*          provenance manifests
#   requirements*.txt                      pinned environment

# ---------------------------------------------------------------------------
# Raw downloaded datasets — immutable, re-acquirable from the pinned manifest.
# The MANIFEST.json describing them IS tracked; the bytes are not.
# ---------------------------------------------------------------------------
data/raw/
data/external/
data/mzml/
data/massbank/
*.mzML
*.mzXML
*.raw
*.RAW
*.mzML.gz
*.wiff
*.wiff.scan

# ---------------------------------------------------------------------------
# Generated artifacts — regenerable by re-running Phase 1.
# ---------------------------------------------------------------------------
artifacts/*
data/interim/
data/processed/
outputs/

# ...but provenance manifests are evidence, not artifacts. Always tracked.
!artifacts/MANIFEST*.json
!artifacts/*SHA256*
!artifacts/replicate_compound_keys.json

# The sealed confirmation set is the seal itself: its SHA-256 is quoted in
# PREREGISTRATION.md, so the file has to be in the repository for that hash to
# be checkable. Tracked, and never opened during Phase 2.
!artifacts/confirmation_set_sealed.json

# Machine-readable Phase 2 results. Every number in every Phase 2 markdown
# report is generated from these, so they are the reproducibility record rather
# than regenerable scratch (Phase 2 instruction 28). All are small JSON.
!artifacts/p2_*.json

# Machine-readable Phase 3 results, on the same principle: every number in every
# Phase 3 report is generated from these. The checkpoint store underneath is
# regenerable scratch — thousands of per-seed files — and stays ignored.
!artifacts/p3_*.json
artifacts/p3_ckpt/

# WUR Stage 0 identity census: the qualifying-trajectory/scaffold-group counts
# Task 5/6 check the sealed-part floor against. Tracked provenance, not
# regenerable scratch.
!artifacts/wur_identity_census.json
!artifacts/wur_population_audit.json

# WUR Stage 0 split/sealed-partition manifests: the D1-D5 side assignment
# and the sealed-part connectivity-key manifest. Tracked provenance, not
# regenerable scratch.
!artifacts/wur_split_manifest.json
!artifacts/wur_sealed_partition.json
!artifacts/wur_dev_neg_keys.json
!artifacts/wur_bridge_gate.json

# MSnLib confirmation study (post-PR#5): preflight/reproducibility manifests,
# the confirmation freeze, the one-look access/result records. Small JSON
# evidence, not regenerable scratch — always tracked. Raw mzML is never
# written here.
!artifacts/wur_v2_confirmation/
!artifacts/wur_v2_confirmation/**
# MSnLib confirmation study 2 (replacement population): exposure registry, security evidence, freeze and
# access records. Tracked so an access record can never hide from git status.
!artifacts/wur_v2_confirmation_v2/
!artifacts/wur_v2_confirmation_v2/**
!artifacts/wur_mu_provenance.json
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle

# Figures are regenerated by the reporting step.
figures/
*.png
*.pdf.tmp
*.svg
!MURU_Reference_Pack/**/*.pdf

# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.joblib_cache/
.cache/
*.log

# ---------------------------------------------------------------------------
# Virtual environments / build
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version
*.egg-info/
build/
dist/
.eggs/

# ---------------------------------------------------------------------------
# Secrets and credentials — never committed.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.yaml
secrets.yml
credentials.json
.netrc
.aws/
.ssh/

# ---------------------------------------------------------------------------
# macOS / editor metadata
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride
Icon?
.idea/
.vscode/
*.swp
*.swo
*~

# Objective-alignment validation study (ov-*): machine-readable evidence is
# tracked; the per-seed checkpoint store and the selection/adjudication stores
# are regenerable by re-running the study and are not.
!artifacts/ov_*.json
artifacts/ov_ckpt/
artifacts/ov_sel/
artifacts/ov_adj/

# Prospective paper-benchmark manifests, preflight, and freeze status are the
# reproducibility record. Generated row-level inputs/truths remain sealed
# regenerable bytes whose SHA-256 values are committed in the inventory.
!artifacts/paper_benchmark_*.json

# E0 (v2 calibration): the analysis inputs and outputs are evidence, tracked.
# The 583k-row fit-level parquet is regenerable from the seeds and is not.
!artifacts/e0/
artifacts/e0/*.parquet

# fresh holdout: reference symlinks into the primary repo artifacts
artifacts/p2_*.parquet
artifacts/ov_ckpt

# fresh holdout: raw search outputs and scored evidence are the one-shot
# experiment's primary record, not regenerable-by-convenience artifacts.
!artifacts/fh_ckpt/
!artifacts/fh_ckpt/**
!artifacts/fresh_holdout/
!artifacts/fresh_holdout/**

# comparator feasibility audit: outcome-blind provenance and overlap evidence
!artifacts/comparator_feasibility/
!artifacts/comparator_feasibility/**
