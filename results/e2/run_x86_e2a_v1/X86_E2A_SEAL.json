 "ADDENDUM_scientific_timeout_counter_is_dead": {
  "added_after_seal_generation": true,
  "issue": "this seal's own fields `scientific_timeouts_simplify_timeout_rows` and `worlds_containing_simplify_timeout` both report 0, but that 0 is an artifact, not a finding. seal_x86_e2a.py counts SIMPLIFY_TIMEOUT by reading `canonicalization_status` off candidate rows, and e2_run_shard_lazy.py writes NO classification-derived column to any candidate row -- a deliberate, documented property of the rescue-v2 candidate schema. The key is always absent, so the counter can only ever report 0.",
  "actual_figure": {
   "simplify_timeout_distinct_expressions": 397,
   "total_distinct_expressions_classified": 52450,
   "fraction": 0.007569113441372736,
   "source": "the PersistentClassifyCache, which stores the whole ClassificationResult including canonicalization_status",
   "audit_file": "SIMPLIFY_TIMEOUT_AUDIT.json"
  },
  "denominator_caveat": "397 counts DISTINCT EXPRESSION STRINGS this run classified, not candidate rows and not worlds. Under the lazy path an expression is classified only if the minimal-witness order reaches it, so this is what the run genuinely evaluated -- it is not the divergence rate under full reclassification.",
  "routing_impact": "none -- Gate 2 consumes first_loss_stage counts, not canonicalization_status."
 }
